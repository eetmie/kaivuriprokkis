<?xml version="1.0" encoding="UTF-8"?>
<robot name="kaivuri_excavator">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="excavator"/>

  <group name="excavator_arm">
    <chain base_link="lower_carriage" tip_link="tool_body"/>
  </group>

  <group_state name="home" group="excavator_arm">
    <joint name="revolute_cabin" value="0.0"/>
    <joint name="revolute_lift" value="0.45"/>
    <joint name="revolute_tilt" value="0.25"/>
    <joint name="revolute_scoop" value="-0.8"/>
  </group_state>

  <disable_collisions link1="lower_carriage" link2="upper_carriage" reason="Adjacent"/>
  <disable_collisions link1="upper_carriage" link2="lift_boom" reason="Adjacent"/>
  <disable_collisions link1="lift_boom" link2="tilt_boom" reason="Adjacent"/>
  <disable_collisions link1="tilt_boom" link2="tool_body" reason="Adjacent"/>
  <disable_collisions link1="tool_body" link2="gripper_frame" reason="Adjacent"/>
  <disable_collisions link1="gripper_frame" link2="gripper_claw_1" reason="Adjacent"/>
  <disable_collisions link1="gripper_frame" link2="gripper_claw_2" reason="Adjacent"/>
</robot>
