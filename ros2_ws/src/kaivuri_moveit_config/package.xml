<?xml version="1.0"?>
<package format="3">
  <name>kaivuri_moveit_config</name>
  <version>0.1.0</version>
  <description>Starter MoveIt configuration for the Kaivuri excavator.</description>
  <maintainer email="joel@example.com">joel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>kaivuri_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
